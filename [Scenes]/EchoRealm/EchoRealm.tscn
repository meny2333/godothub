[sub_resource type="Shader" id="Shader_mesh_fog"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, blend_mix;

uniform vec4 cloud_color : source_color = vec4(0.470588, 0.552941, 0.611765, 0.16);
uniform vec2 cloud_speed = vec2(0.012, 0.006);

float hash(vec2 point) {
	return fract(sin(dot(point, vec2(127.1, 311.7))) * 43758.5453123);
}

float value_noise(vec2 point) {
	vec2 cell = floor(point);
	vec2 local = fract(point);
	local = local * local * (3.0 - 2.0 * local);
	float lower = mix(hash(cell), hash(cell + vec2(1.0, 0.0)), local.x);
	float upper = mix(hash(cell + vec2(0.0, 1.0)), hash(cell + vec2(1.0, 1.0)), local.x);
	return mix(lower, upper, local.y);
}

float fbm(vec2 point) {
	float result = 0.0;
	float amplitude = 0.5;
	for (int octave = 0; octave < 4; octave++) {
		result += value_noise(point) * amplitude;
		point = point * 2.03 + vec2(13.7, 7.1);
		amplitude *= 0.5;
	}
	return result;
}

void fragment() {
	vec2 cloud_uv = UV * vec2(2.3, 1.25) + TIME * cloud_speed;
	float cloud_shape = smoothstep(0.38, 0.7, fbm(cloud_uv * 4.0));
	float horizontal_fade = smoothstep(0.0, 0.16, UV.x) * (1.0 - smoothstep(0.84, 1.0, UV.x));
	float vertical_fade = smoothstep(0.0, 0.22, UV.y) * (1.0 - smoothstep(0.78, 1.0, UV.y));
	ALBEDO = cloud_color.rgb;
	ALPHA = cloud_color.a * cloud_shape * horizontal_fade * vertical_fade;
}
"

