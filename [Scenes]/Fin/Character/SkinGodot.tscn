[sub_resource type="Shader" id="Shader_ul48q"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, blend_mix;

uniform vec4 gold_color : source_color = vec4(1.0, 0.8784314, 0.627451, 1.0);
uniform vec4 sky_color : source_color = vec4(0.6117647, 0.8627451, 1.0, 1.0);
uniform float seed = 0.0;

float hash21(vec2 p) {
    p = fract(p * vec2(123.34, 345.45));
    p += dot(p, p + 34.345);
    return fract(p.x * p.y);
}

void vertex() {
    MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
        INV_VIEW_MATRIX[0],
        INV_VIEW_MATRIX[1],
        INV_VIEW_MATRIX[2],
        MODEL_MATRIX[3]
    );
}

void fragment() {
    float frame = floor(TIME * 24.0);
    float band = floor(UV.y * 24.0);
    float band_random = hash21(vec2(band + seed, frame));
    float horizontal_shift = (band_random - 0.5) * 0.24 * step(0.52, band_random);
    vec2 glitch_uv = UV + vec2(horizontal_shift, 0.0);

    float inside = step(0.0, glitch_uv.x) * step(glitch_uv.x, 1.0);
    float block = hash21(floor(vec2(glitch_uv.x * 14.0, glitch_uv.y * 30.0)) + vec2(frame, seed));
    float scan = pow(1.0 - abs(fract(glitch_uv.y * 20.0 - TIME * 5.0) * 2.0 - 1.0), 10.0);
    float dropout = step(0.2, hash21(vec2(floor(glitch_uv.y * 35.0), frame + seed * 0.13)));

    vec3 glitch_color = mix(gold_color.rgb, sky_color.rgb, step(0.55, block));
    glitch_color += vec3(1.0, 0.9411765, 0.7607843) * scan * 0.18;
    ALBEDO = glitch_color;
    EMISSION = glitch_color * 1.5;
    ALPHA = inside * dropout * (0.18 + block * 0.60 + scan * 0.35);
    if (ALPHA < 0.08) {
        discard;
    }
}"

