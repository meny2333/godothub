[sub_resource type="Shader" id="Shader_godot_preview_offset"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec2 shifted_uv = UV - vec2(0.0, 0.12);\n\tif (shifted_uv.y < 0.0) {\n\t\tCOLOR = vec4(0.0);\n\t} else {\n\t\tCOLOR = texture(TEXTURE, shifted_uv);\n\t}\n}\n"

